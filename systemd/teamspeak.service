[Unit]
Description=TeamSpeak 3 Server Daemon (Enterprise Edition)
After=network.target network-online.target
Wants=network-online.target
Documentation=https://www.teamspeak.com/

[Service]
Type=forking
User=teamspeak
Group=teamspeak
WorkingDirectory=/opt/teamspeak
# Clean stale shared-memory accounting locks (prevents 'failed to register local accounting service' crash)
ExecStartPre=+/bin/sh -c 'rm -f /dev/shm/7gb* 2>/dev/null || true'
ExecStart=/opt/teamspeak/ts3server_startscript.sh start inifile=ts3server.ini
ExecStop=/opt/teamspeak/ts3server_startscript.sh stop
ExecReload=/opt/teamspeak/ts3server_startscript.sh restart inifile=ts3server.ini
PIDFile=/opt/teamspeak/ts3server.pid
Restart=always
RestartSec=5s

# Latency and System Resource Limits
Nice=-5
LimitNOFILE=65535
LimitNPROC=32768
LimitMEMLOCK=infinity

# Critical Library Path (prevents vtable/pure virtual function crashes on modern Ubuntu)
Environment="LD_LIBRARY_PATH=/opt/teamspeak"

[Install]
WantedBy=multi-user.target
